{
  "name": "youtrack-app-example",
  "version": "2.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode backend && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
