{
  "name": "youtrack-app-example",
  "version": "2.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --mode backend && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "pack": "rm -rf archive_name.zip && cd build && zip -r ../archive_name.zip .",
    "upload": "youtrack-workflow upload build"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.23.4",
    "@jetbrains/ring-ui-built": "^7.0.126",
    "@jetbrains/youtrack-scripting": "^0.2.1",
    "@jetbrains/youtrack-scripting-api": "^2022.1.46592",
    "@vitejs/plugin-react": "^6.1.1",
    "date-fns": "^4.4.0",
    "html-to-pdfmake": "^2.5.34",
    "i18next": "^26.4.2",
    "markdown-it": "^15.0.2",
    "pdfmake": "^0.3.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "run": "^2.1.7",
    "tailwindcss": "^4.3.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^8.3.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.23.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/html-to-pdfmake": "^2.4.5",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
